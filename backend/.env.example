# Development example. Production must provide its own database URL.
DATABASE_URL=postgresql+psycopg://lease_user:lease_password@localhost:5433/know_your_lease
ENVIRONMENT=development
# Production requires an HTTPS, non-loopback origin.
FRONTEND_ORIGIN=http://localhost:3000
# Explicit local fallbacks for an occupied port or a 127.0.0.1 browser URL.
# Ignored when ENVIRONMENT is not development.
ADDITIONAL_FRONTEND_ORIGINS=http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
# Defaults to enabled only in development. Never enable in production.
# DEBUG_ENDPOINTS_ENABLED=true
MAX_UPLOAD_SIZE_MB=20
# Inline keeps the local FastAPI background task. Production can select sqs to
# publish durable ingestion work for the standalone worker.
INGESTION_MODE=inline
# Required only when INGESTION_MODE=sqs. Messages contain a version and document UUID.
# SQS_INGESTION_QUEUE_URL=https://sqs.ca-central-1.amazonaws.com/123456789012/know-your-lease-ingestion
# A processing attempt older than this can be reclaimed after a worker crash. Keep
# the SQS visibility timeout at least this long and above normal ingestion duration.
INGESTION_PROCESSING_TIMEOUT_SECONDS=900
# Disabled keeps local development/tests auth-free with a deterministic local user.
# Production must set cognito explicitly; a missing/expired/wrong-pool/wrong-client
# token is rejected. Required when AUTH_MODE=cognito: COGNITO_REGION,
# COGNITO_USER_POOL_ID, COGNITO_APP_CLIENT_ID. COGNITO_ISSUER is optional and is
# derived from the region/pool id when omitted.
AUTH_MODE=disabled
# COGNITO_REGION=ca-central-1
# COGNITO_USER_POOL_ID=ca-central-1_xxxxxxxxx
# COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# COGNITO_ISSUER=https://cognito-idp.ca-central-1.amazonaws.com/ca-central-1_xxxxxxxxx
# Local is the development/test default. Set s3 for private AWS object storage.
DOCUMENT_STORAGE_BACKEND=local
# Used only by local storage. Railway local-storage production uses /data/documents.
# PDF_STORAGE_DIR=./storage
# Required when DOCUMENT_STORAGE_BACKEND=s3 or INGESTION_MODE=sqs. Credentials use
# boto3's standard provider chain (AWS profile/environment locally; an IAM task role).
# S3_BUCKET_NAME=know-your-lease-documents
# AWS_REGION=ca-central-1
# Stage 2 document embeddings.
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-law-2
# Stage 3 grounded answer generation. Keep secrets only in backend/.env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Bump after material grounding prompt or response-format changes to invalidate old answers.
ANSWER_CACHE_VERSION=v1
