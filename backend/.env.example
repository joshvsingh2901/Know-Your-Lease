# Local development defaults. Copy this file to backend/.env and add provider
# secrets only when exercising provider-backed routes locally.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://lease_user:lease_password@localhost:5433/know_your_lease
FRONTEND_ORIGIN=http://localhost:3000
ADDITIONAL_FRONTEND_ORIGINS=http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
MAX_UPLOAD_SIZE_MB=20
INGESTION_MODE=inline
INGESTION_PROCESSING_TIMEOUT_SECONDS=900
AUTH_MODE=disabled
DOCUMENT_STORAGE_BACKEND=local
# PDF_STORAGE_DIR=./storage
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-law-2
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
ANSWER_CACHE_VERSION=v1

# Phase 6 production deployment map
#
# Do not give every ECS workload this entire file. Inject only its section.
# Values below are placeholders; AWS resources do not exist yet.

# API non-secret environment
# ENVIRONMENT=production
# PORT=8000
# DOCUMENT_STORAGE_BACKEND=s3
# S3_BUCKET_NAME=<private-pdf-bucket>
# AWS_REGION=ca-central-1
# INGESTION_MODE=sqs
# SQS_INGESTION_QUEUE_URL=<main-ingestion-queue-url>
# INGESTION_PROCESSING_TIMEOUT_SECONDS=900
# AUTH_MODE=cognito
# COGNITO_REGION=ca-central-1
# COGNITO_USER_POOL_ID=<user-pool-id>
# COGNITO_APP_CLIENT_ID=<public-app-client-id>
# FRONTEND_ORIGIN=https://<vercel-production-domain>
# DEBUG_ENDPOINTS_ENABLED=false
# ANSWER_CACHE_VERSION=v1
# API secrets from Secrets Manager
# DATABASE_URL=<runtime-postgresql-url>
# VOYAGE_API_KEY=<secret>
# GEMINI_API_KEY=<secret>

# Worker non-secret environment
# ENVIRONMENT=production
# DOCUMENT_STORAGE_BACKEND=s3
# S3_BUCKET_NAME=<private-pdf-bucket>
# AWS_REGION=ca-central-1
# INGESTION_MODE=sqs
# SQS_INGESTION_QUEUE_URL=<main-ingestion-queue-url>
# INGESTION_PROCESSING_TIMEOUT_SECONDS=900
# Worker secrets from Secrets Manager
# DATABASE_URL=<runtime-postgresql-url>
# VOYAGE_API_KEY=<secret>

# Migration task secret; no other application configuration is required.
# DATABASE_URL=<migration-postgresql-url>

# Vercel public build configuration belongs in frontend/.env.local locally or
# the Vercel project settings. These values are not backend secrets.
# NEXT_PUBLIC_API_BASE_URL=https://api.<domain>
# NEXT_PUBLIC_COGNITO_DOMAIN=https://<domain>.auth.ca-central-1.amazoncognito.com
# NEXT_PUBLIC_COGNITO_APP_CLIENT_ID=<public-app-client-id>
# NEXT_PUBLIC_COGNITO_REDIRECT_URI=https://<vercel-production-domain>/auth/callback
