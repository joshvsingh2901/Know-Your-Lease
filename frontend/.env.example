# Local default. Set this to the Railway HTTPS API origin in Vercel Production.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Leave all four unset for local development: the app then requires no sign-in,
# matching the backend's AUTH_MODE=disabled. This repository does not provision or
# run a live Cognito user pool -- these are only read if a real pool's values are set.
# Public client only; a client secret must never be exposed to the browser.
# Read by lib/auth.ts (Hosted UI PKCE redirect + token exchange):
# NEXT_PUBLIC_COGNITO_DOMAIN=https://your-domain.auth.ca-central-1.amazoncognito.com
# NEXT_PUBLIC_COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_COGNITO_REDIRECT_URI=http://localhost:3000/auth/callback
# Not read by the client today; kept for parity with the backend's Cognito settings:
# NEXT_PUBLIC_COGNITO_REGION=ca-central-1
# NEXT_PUBLIC_COGNITO_USER_POOL_ID=ca-central-1_xxxxxxxxx
